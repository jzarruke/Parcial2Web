PORT=3000

# PostgreSQL (docker-compose.yml lee estas mismas variables)
DB_HOST=localhost
DB_PORT=5432
DB_USER=parcial2_app
DB_PASS=cambia_esta_password
DB_NAME=usuarios_roles

# JWT (JWT_SECRET: minimo 32 caracteres aleatorios)
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=2m
JWT_REFRESH_EXPIRES_IN=7d
